{
  "version": 6,
  "_说明": "角色技能数据。steps 按数组顺序执行，每一步用 do 指定行为；新增行为时扩展 do 的可选值。",
  "_schema": {
    "id": "技能唯一 id，推荐 skill_{character_id}_{slot}",
    "character_id": "角色数字 ID",
    "owner_type": "技能归属类型：main_character、job、character、weapon、summon 等",
    "owner_id": "技能归属对象 id；角色旧数据可继续使用 character_id",
    "slot": "技能槽位",
    "cooldown": "主动技能使用间隔（回合）；例如 5 表示 T1 使用后 T6 可再次使用",
    "name": "技能名",
    "icon": "技能图标路径，相对 images/",
    "desc": "展示用说明，不参与计算",
    "kind": "active 表示主动技能；passive 表示被动技能。旧数据未填写时默认 active。",
    "trigger": "被动触发条件；开局被动使用 { event: battle_start, once: true }。",
    "show_icon": "false 时，角色 Buff 栏只显示技能赋予的 buff 图标，不显示技能图标本身",
    "steps": "按顺序执行。每个 step 必须填写且只填写一个 do 行为。",
    "damage_step": "do=damage；填写 target、damage_type、element、mult、hits、threshold_table、cap。",
    "buff_step": "do=buff；单效果填写 prop、zone、value；专用 Buff 的多个小效果填写在 effects 中。",
    "buff_display": "大Buff可在各 buff step 填写相同 status_display: { mode: large, group_id, label, initial }；计算仍逐step执行，显示时按group_id聚合为一个首字图标。"
  },
  "_resolution_schema": {
    "events": "通用时点示例：battle_start、turn_start、attack_action_start、before_command、before_damage、damage_resolved、normal_attack_resolved、triple_attack_resolved、charge_attack_resolved、status_applied、attack_action_end、turn_end。新机制优先复用通用事件，也可通过 do=emit_event 发布新事件。",
    "trigger": "被动技能可填写 trigger，或用 triggers 定义多个触发器。字段包括 event、watch、priority、insertion、conditions、counter、limits、once、steps。",
    "watch": "any、self、ally_party（前排）、ally_all（含后排）。",
    "insertion": "interrupt=立即插入后返回原结算；modifier=在原命令前修改状态或参数；follow_up=当前动作完成后；replace=替换当前命令；deferred=推迟到 window 指定时点。",
    "conditions": "支持 all、any、not 递归组合；叶节点使用 path/field、op、value，例如 { path: event.attackActionIndex, op: >=, value: 2 }。",
    "counter": "触发器计数器字段：id、scope、add、threshold、on_threshold；party_shared 可用于全队共享的每3次TA等机制。",
    "limits": "支持 max_per_turn、max_per_battle、ignore_tags；once=true 等同整场最多一次。",
    "action_duration": "只覆盖当前一次行动的状态使用 duration: { type: action, value: 1, tick: attack_action_end }；触发时会绑定当前 actionId、行动序号和行动角色，并在对应行动结束后移除。",
    "stacking": "可叠层状态使用 stacking: { mode: add, add: 1, max: 5, refresh_duration: false }；同 status_id 再次获得时增加层数而不是覆盖。scale_effects=true 时公式效果量乘以当前层数。",
    "extensible_steps": "当前通用扩展步骤：counter、set_flag、remove_status、extend_status、reduce_cooldown、schedule_action、cancel_action、replace_action、emit_event。新的 do 可通过 StatusResolver.registerStepHandler 与 BattleResolution.registerEffectExecutor 注册。",
    "note": "技能数据只描述触发条件与效果步骤；伤害公式、Buff分区合并和结算顺序仍分别由计算层、BuffRegistry与结算引擎负责。"
  },
